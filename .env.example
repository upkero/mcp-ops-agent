# Copy this file to .env and adjust the values for your environment.
# This service stores nothing itself — it has NO database configuration.
# All data comes from ops-core-api over HTTP; the agent is a pure MCP + orchestration layer.

# +--------------------------------------------------------------------------+
# | LOGGING  (src.app.core.settings.logging.LoggingSettings)                 |
# +--------------------------------------------------------------------------+
LOG_LEVEL="INFO"          # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT="json"         # json (production) | text (local development)

# +--------------------------------------------------------------------------+
# | HTTP / CORS  (src.app.core.settings.app.AppSettings)                     |
# +--------------------------------------------------------------------------+
# JSON array of allowed origins. Use ["*"] only for local development.
# CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# +--------------------------------------------------------------------------+
# | UPSTREAM: ops-core-api  (src.app.core.settings.ops_core.OpsCoreSettings) |
# +--------------------------------------------------------------------------+
# Base URL of ops-core-api, WITHOUT the /api/v1 suffix.
# Outside docker use localhost; from a container use host.docker.internal.
OPS_CORE_BASE_URL="http://localhost:8000"
# API key sent as the X-API-Key header to ops-core-api (min length 16).
OPS_CORE_API_KEY="change-me-min-16-chars"
OPS_CORE_TIMEOUT_SECONDS=10.0
OPS_CORE_MAX_RETRIES=2

# +--------------------------------------------------------------------------+
# | AGENT / MCP SELF-LOOPBACK  (src.app.core.settings.agent.AgentSettings)   |
# +--------------------------------------------------------------------------+
# Max reasoning steps (LLM turns) before the orchestrator stops the tool loop.
AGENT_MAX_STEPS=6
# URL the internal orchestrator uses to reach THIS server's own mounted MCP
# endpoint over real Streamable HTTP (the self-loopback). Same URL Claude Desktop
# would use. Keep the /mcp path. Inside one container localhost is correct.
AGENT_MCP_SELF_URL="http://localhost:8000/mcp"

# +--------------------------------------------------------------------------+
# | LLM  (src.app.core.settings.llm.LLMSettings)                            |
# +--------------------------------------------------------------------------+
# Provider profile: openai | openai_compatible | ollama
# The concrete client is OpenAI-compatible; the demo default targets OpenAI.
# A tool-capable model is required (function calling) — e.g. gpt-4o-mini.
LLM_PROVIDER="openai"
LLM_MODEL="gpt-4o-mini"
LLM_API_KEY="sk-your-openai-key"    # required when LLM_PROVIDER=openai
# For a local OpenAI-compatible endpoint (e.g. Ollama) instead:
#   LLM_PROVIDER="ollama"
#   LLM_MODEL="qwen2.5:7b"
#   LLM_BASE_URL="http://localhost:11434/v1"
# LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60.0
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.0
# LLM_MAX_TOKENS=1024
